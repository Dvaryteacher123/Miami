# PhonephixBot - single user. Copy to .env (or set these in Render/Railway/Heroku "Environment Variables").

# YOUR WhatsApp number with country code, no "+" and no spaces.
# Needed on hosts without a typing console (Render, Railway, Heroku).
# On a VPS / panel you can leave it empty: the bot will ask you in the console.
WHATSAPP_NUMBER=

# Hosting platforms that give a PORT (Render web service, Heroku web) only get a tiny
# "Phonephix Bot is running" keep-alive page. There is no website.

BOT_NAME=PHONEPHIX
BOT_VERSION=1.0.0
BOT_OWNER=Phonephix
DEFAULT_PREFIX=.
BOT_MODE=public
BOT_TIMEZONE=Africa/Dar_es_Salaam
BOT_FOOTER=Powered by Phonephix

# Where the session is saved. On Render/Heroku/Railway use a persistent disk/volume,
# otherwise you must pair again after every redeploy.
# DATA_DIR=./data

# Optional AI key for .ai commands
AI_API_KEY=
AI_API_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant

# Music sources (all optional)
MUSIC_PROVIDERS=saavn,piped,soundcloud,youtube,community,audius,deezer
# SAAVN_API_URLS=https://your-saavn-api.example/api
# PIPED_INSTANCES=https://your-piped.example
# MUSIC_API_BASES=https://your-api.example
# YT_PROXY=
# Community music APIs: create data/music-apis.json (see music-apis.example.json)

# Weather command
# WEATHER_API_KEY=

# Stability
WA_AUTO_RECONNECT=true
WA_REFRESH_HOURS=0
WA_LOG_LEVEL=silent
LOG_LEVEL=warn

# Menu / branding
MENU_WITH_IMAGE=false
MENU_LOADING_TEXT=🌸 Phonephix loading....
BRAND_BUTTONS=true
BRAND_VERSION=v1.002
COMMAND_REACT=true
CHANNEL_REACT=true
